meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2OWUyMDE2ZTVhZjgzMTkzNWQ5NWFhNmUiLCJlbWFpbCI6InNhaGlsYW5pczIwMTZAZ21haWwuY29tIiwicm9sZSI6InNlbGxlciIsImlhdCI6MTc3NjQyMjI5MSwiZXhwIjoxNzc2NDIzMTkxLCJhdWQiOiJzbWFydC1tYXJrZXRwbGFjZS1jbGllbnQiLCJpc3MiOiJzbWFydC1tYXJrZXRwbGFjZSJ9.fm1FH1eLTpXwiJmlMnZEPUcsuFYlBtWZlpbgFGLV53g
