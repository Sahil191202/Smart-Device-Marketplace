body:json {
  {
    "title": "Sony WH-1000XM5 Wireless Headphones Black",
    "description": "Used for 3 months only, in perfect condition. All accessories and original packaging included.",
    "category": "headphones",
    "brand": "Sony",
    "condition": "like-new",
    "price": 28000,
    "specs": {
      "age_months": 3
    },
    "location": {
      "city": "Bangalore",
      "state": "Karnataka"
    }
  }
}

script:post-response {
  const product = res.getBody().data?.product;
  if (product?._id) {
    bru.setEnvVar("productId", product._id);
    bru.setEnvVar("productSlug", product.slug);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("slug auto-generated", function() {
    expect(res.getBody().data.product.slug).to.be.a("string");
    expect(res.getBody().data.product.slug).to.include("iphone");
  });
  
  test("sellerId matches logged in user", function() {
    expect(res.getBody().data.product.sellerId).to.equal(
      bru.getEnvVar("userId")
    );
  });
  
  test("AI job queued (non-blocking)", function() {
    // Product should be created even though AI job is async
    expect(res.getBody().data.product._id).to.be.a("string");
  });
}
