body:json {
  {
    "label": "Home",
    "line1": "789 Linking Road, Bandra",
    "city": "Mumbai",
    "state": "Maharashtra",
    "pincode": "400050",
    "country": "India",
    "isDefault": true
  }
}

script:post-response {
  const addresses = res.getBody().data?.addresses;
  if (addresses?.length > 0) {
    bru.setEnvVar("addressId", addresses[0]._id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("address added to array", function() {
    expect(res.getBody().data.addresses).to.be.an("array");
    expect(res.getBody().data.addresses.length).to.be.greaterThan(0);
  });
  
  test("pincode validation", function() {
    expect(res.getBody().data.addresses[0].pincode).to.equal("400001");
  });
}
