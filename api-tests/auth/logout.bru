meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/logout
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  // Clear token from environment after logout
  if (res.getStatus() === 200) {
    bru.setEnvVar("accessToken", "");
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}