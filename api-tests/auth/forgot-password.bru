meta {
  name: Forgot Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "seller@test.com"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("generic message (no email enumeration)", function() {
    const msg = res.getBody().message;
    expect(msg).to.include("If that email");
  });
}
