meta {
  name: Get Cart
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/cart
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("cart has items array", function() {
    expect(res.getBody().data.cart.items).to.be.an("array");
  });

  test("cart has total", function() {
    expect(res.getBody().data.cart.total).to.be.a("number");
  });

  test("cart items have required fields", function() {
    const items = res.getBody().data.cart.items;
    if (items.length > 0) {
      expect(items[0].productId).to.be.a("string");
      expect(items[0].price).to.be.a("number");
      expect(items[0].isAvailable).to.be.a("boolean");
    }
  });
}