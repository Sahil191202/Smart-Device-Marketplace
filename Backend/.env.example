# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=SmartMarketplace

# ── MongoDB (local replica set) ───────────────────────
MONGODB_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/?replicaSet=rs0
MONGODB_DB_NAME=smart_marketplace

# ── Redis (local) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=this-is-a-super-secret-key-minimum-32chars
JWT_REFRESH_SECRET=this-is-another-secret-key-minimum-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AWS S3 (dummy for now) ────────────────────────────
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=us-east-1
AWS_S3_BUCKET=dummy-bucket

# ── Email (Mailtrap free account) ─────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@smartmarketplace.com

# ── AI Service (local Python) ─────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000
AI_INTERNAL_KEY=local-internal-key-secret

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Razorpay ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── AI Internal ───────────────────────────────────────
AI_INTERNAL_KEY=local-internal-key-secret